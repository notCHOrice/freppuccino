# Optional. Easier: paste your key in the AI tab (key button), no rebuild needed. A pasted key wins over this one.
# Copy to .env.local (gitignored) and fill in. Vite bakes these into the built UI bundle (src/ui/dist),
# so the key ends up in plain text in the plugin's ui/ folder: fine for local dev, don't ship that build.
VITE_OPENROUTER_API_KEY=sk-or-v1-...
# Optional: default model (any OpenRouter model with vision + tool calling). Changeable in the AI tab.
VITE_OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Optional: another OpenAI-compatible endpoint (proxy, local test server). Default https://openrouter.ai/api/v1
# VITE_OPENROUTER_BASE_URL=
