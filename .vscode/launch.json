{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rhino 9 + Freppuccino",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "osx": {
        "program": "/Applications/Rhino 9.app/Contents/MacOS/Rhinoceros",
        "args": ["-nosplash"]
      },
      "windows": {
        "program": "C:\\Program Files\\Rhino 9\\System\\Rhino.exe",
        "targetArchitecture": "x86_64",
        "args": ["/netcore", "/nosplash"]
      },
      "env": {
        "RHINO_PACKAGE_DIRS": "${workspaceFolder}/src/Freppuccino/bin/Debug/net10.0/",
        "FREPPUCCINO_AUTOSTART": "1"
      },
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      // Side panel loads from the Vite dev server (hot reload). Run `npm run dev` in src/ui first.
      "name": "Rhino 9 + Freppuccino (UI dev server)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "osx": {
        "program": "/Applications/Rhino 9.app/Contents/MacOS/Rhinoceros",
        "args": ["-nosplash"]
      },
      "windows": {
        "program": "C:\\Program Files\\Rhino 9\\System\\Rhino.exe",
        "targetArchitecture": "x86_64",
        "args": ["/netcore", "/nosplash"]
      },
      "env": {
        "RHINO_PACKAGE_DIRS": "${workspaceFolder}/src/Freppuccino/bin/Debug/net10.0/",
        "FREPPUCCINO_AUTOSTART": "1",
        "FREPPUCCINO_UI_DEV_URL": "http://localhost:5173"
      },
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    }
  ]
}
