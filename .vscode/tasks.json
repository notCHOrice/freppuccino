{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "shell",
      "args": ["build", "-clp:NoSummary", "${workspaceFolder}/src/Freppuccino/Freppuccino.csproj"],
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "clear": true },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build release",
      "command": "dotnet",
      "type": "shell",
      "args": ["build", "-c:Release", "-clp:NoSummary", "${workspaceFolder}/src/Freppuccino/Freppuccino.csproj"],
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "clear": true },
      "group": "build"
    }
  ]
}
