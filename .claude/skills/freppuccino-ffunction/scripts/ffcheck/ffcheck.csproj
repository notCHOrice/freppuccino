<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../../../../src/Freppuccino/UserFn/**/*.cs" Link="UserFn/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../../../src/Freppuccino/Shaders/ShaderCompiler.cs;$(MSBuildThisFileDirectory)../../../../../src/Freppuccino/Shaders/NativeLibs.cs;$(MSBuildThisFileDirectory)../../../../../src/Freppuccino/Shaders/Uniforms.cs" Link="Shaders/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
    <PackageReference Include="Silk.NET.SPIRV.Cross.Native" Version="2.23.0" />
  </ItemGroup>
</Project>
